{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.tmp/node"
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "e2e"
  ]
}