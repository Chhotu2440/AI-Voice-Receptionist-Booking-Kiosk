# Copy to .env and fill in. Never commit .env. (No inline comments: keep values on their own.)

# dev | test | staging | prod
APP_ENV=dev
LOG_LEVEL=INFO

# Async SQLAlchemy URL (asyncmy driver). In docker compose the host is "mysql".
DATABASE_URL=mysql+asyncmy://plt:CHANGE_ME_APP_DB_PASSWORD@mysql:3306/playlasertag?charset=utf8mb4
REDIS_URL=redis://redis:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME

# Set to false only for local plain-http development.
REFRESH_COOKIE_SECURE=true

CORS_ORIGINS=["http://localhost:5173"]
EXPOSE_DOCS=true

# Used by the MySQL container (docker compose). MYSQL_PASSWORD must match DATABASE_URL.
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
MYSQL_PASSWORD=CHANGE_ME_APP_DB_PASSWORD

# Voice (Sprint 4). Keys stay on the server; the kiosk never receives them.
# openai | gemini   ("scripted" is a test double and is refused in staging/prod)
VOICE_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_VOICE=marin
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VOICE=Kore
